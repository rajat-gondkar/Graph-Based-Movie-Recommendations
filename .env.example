# Copy this file to .env (same folder) and fill in your values. Never commit .env.
# Keep comments on their own lines: inline comments can end up inside values.

# OpenRouter, for the LLM calls. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# Model id from https://openrouter.ai/models. Pick a cheap instruct model.
OPENROUTER_MODEL=put_a_model_id_here
# Optional: reasoning effort for models that think before answering (minimal, low, medium, high).
# Unset means "minimal". An empty value means the setting isn't sent at all.
# OPENROUTER_REASONING_EFFORT=minimal

# TMDB, for plots and posters. Get a key at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
TMDB_API_KEY=your_tmdb_key_here

# Neo4j. Docker Compose also reads NEO4J_PASSWORD from this file.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters. Avoid $ and quotes. Set it before the first `docker compose up`.
NEO4J_PASSWORD=change_me_min8chars
